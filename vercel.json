{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-redesign.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/systems-desk.mjs": { "maxDuration": 90 },
    "api/business-audit.mjs": { "maxDuration": 60 }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/portfolio", "destination": "/case-studies", "permanent": true },
    { "source": "/pricing", "destination": "/contact#engagement", "permanent": true },
    { "source": "/book", "destination": "/contact", "permanent": true },
    { "source": "/blog", "destination": "/insights", "permanent": true },
    { "source": "/audit", "destination": "https://signal.aixcelsolutions.com/audit", "permanent": true },
    { "source": "/login", "destination": "https://signal.aixcelsolutions.com/login", "permanent": true },
    { "source": "/workspace", "destination": "https://signal.aixcelsolutions.com/workspace", "permanent": true },
    { "source": "/method", "destination": "https://signal.aixcelsolutions.com/method", "permanent": true },
    { "source": "/services/ai-search-visibility", "destination": "https://signal.aixcelsolutions.com/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://ozvltcgrmgzeyoxklozz.supabase.co; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
