# Manhaj Bridge — copy to .env and fill in (never commit .env)

# Slack bot token (xoxb-...) from OAuth & Permissions after install
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token (xapp-...) with connections:write for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Signing secret from Basic Information (required by Bolt; used if SLACK_MODE=http)
SLACK_SIGNING_SECRET=your-signing-secret

# Bearer token callers must send as: Authorization: Bearer <BRIDGE_API_KEY>
BRIDGE_API_KEY=generate-a-long-random-secret

# HTTP listen port for POST /v1/post (and health)
PORT=8787

# Optional: set to "http" to use Events API + HTTP instead of Socket Mode
# SLACK_MODE=socket
